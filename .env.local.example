# Hugging Face token used server-side only, for the optional natural-
# language intake extraction feature (Issue #6). Never bundled to the
# client — only read inside src/app/api/intake/extract/route.ts.
#
# Create one at https://huggingface.co/settings/tokens with the
# "Make calls to Inference Providers" permission.
#
# Copy this file to .env.local and fill in your own token. .env.local is
# already gitignored — never commit a real token.
HF_TOKEN=
